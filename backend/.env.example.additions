# Tambahkan baris-baris ini ke file .env project Laravel kamu

GROQ_API_KEY=isi_api_key_groq_kamu
GROQ_MODEL=llama-3.3-70b-versatile

# Provider embedding - contoh pakai OpenAI, bisa diganti provider lain
# yang kompatibel format /v1/embeddings (mis. Jina AI, HuggingFace)
EMBEDDING_API_KEY=isi_api_key_embedding_kamu
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
